# Modèle de configuration locale — copiez ce fichier vers .env puis adaptez.
#   cp .env.example .env
# docker compose lit automatiquement .env ; le backend le charge via ./dev.sh.

# Comptes de démonstration. Ces comptes à mots de passe connus ne doivent être
# semés QUE dans un environnement de développement/démo (jamais en production) :
STOCK_DATA_INITIALIZER_SEED_ACCOUNTS=true
# Clé de signature JWT (Base64, >= 32 octets décodés) — OBLIGATOIRE, générez-la :
#   openssl rand -base64 48
JWT_SECRET=CHANGEZ_MOI_collez_ici_une_cle_base64_de_48_octets

# === PostgreSQL (backend Spring) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_db
DB_USERNAME=stock_user
DB_PASSWORD=CHANGEZ_MOI

# === PostgreSQL (conteneur docker compose) ===
POSTGRES_PASSWORD=CHANGEZ_MOI

# Stockage d'images (MinIO) — activer avec IMAGE_STORAGE_MODE=s3
IMAGE_STORAGE_MODE=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=product-images
