# Modèle de configuration locale — copiez ce fichier vers .env puis adaptez.
#   cp .env.example .env
# docker compose lit automatiquement .env ; le backend le charge via ./dev.sh.

# Clé de signature JWT (Base64, >= 32 octets décodés) — OBLIGATOIRE, générez-la :
#   openssl rand -base64 48
JWT_SECRET=CHANGEZ_MOI_collez_ici_une_cle_base64_de_48_octets

# === PostgreSQL (backend Spring) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_db
DB_USERNAME=stock_user
DB_PASSWORD=CHANGEZ_MOI

# === PostgreSQL (conteneur docker compose) ===
POSTGRES_PASSWORD=CHANGEZ_MOI



