              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"EXIT\",\n  \"productId\": 1,\n  \"quantity\": 5,\n  \"reason\": \"Livraison client #123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock-movements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-movements"]
            }
          }
        },
