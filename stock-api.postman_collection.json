    },
    {
      "name": "📊 Stock",
      "item": [
        {
          "name": "Entrée de stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('movementId', data.id);",
                  "    console.log('Mouvement créé: ID=' + data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ENTRY\",\n  \"productId\": 1,\n  \"quantity\": 50,\n  \"reason\": \"Réapprovisionnement fournisseur\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock-movements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-movements"]
            }
          }
        },
        {
          "name": "Sortie de stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
